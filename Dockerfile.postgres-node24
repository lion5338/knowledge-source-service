FROM node:24.18.1-bookworm-slim@sha256:235600a8101ab264e117b1768e925532262668dc9b581ef1dd7d96ced463b8e7 AS node
FROM postgres:17.6-bookworm@sha256:f3bd19c606e442c3d7bdfa8002e03fe260a1023351e0ea4598032022b68dd6e3
RUN apt-get update && apt-get install -y --no-install-recommends libstdc++6 && rm -rf /var/lib/apt/lists/*
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY scripts/runtime/environment.mjs scripts/runtime/postgres-bootstrap.mjs scripts/runtime/postgres-healthcheck.mjs /opt/source-runtime/
ENTRYPOINT ["node", "/opt/source-runtime/postgres-bootstrap.mjs"]
CMD ["postgres"]

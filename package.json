{
  "name": "knowledge-source-service",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18.19.1"
  },
  "scripts": {
    "dev": "next dev --port 3200",
    "dev:host": "next dev --hostname 0.0.0.0 --port 3200",
    "build": "next build",
    "build:isolated": "node scripts/build-isolated.mjs",
    "start": "next start -p 3200",
    "test": "node --experimental-default-type=module --test test",
    "lint": "eslint",
    "openapi:validate": "node scripts/openapi/validate-openapi.mjs",
    "db:migrate": "node scripts/db/migrate.mjs",
    "import:ai-workflow-knowledge": "node scripts/import/import-ai-workflow-knowledge.mjs",
    "source-collections:seed": "node --experimental-default-type=module scripts/source-collections/seed-source-collections.mjs",
    "source-collections:ingest": "node --experimental-default-type=module scripts/source-collections/ingest-source-collection.mjs",
    "source-artifacts:build": "node --experimental-default-type=module scripts/source-artifacts/build-source-artifact.mjs",
    "topic-candidates:build": "node --experimental-default-type=module scripts/topic-candidates/build-topic-candidates.mjs",
    "runtime-index:publish": "node --experimental-default-type=module scripts/runtime-index/publish-runtime-index.mjs",
    "retrieval-index:build": "node --experimental-default-type=module scripts/retrieval-index/build-retrieval-index.mjs",
    "source:sole-source:smoke": "node --experimental-default-type=module scripts/readiness/source-sole-source-smoke.mjs"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "next": "^15.5.21",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "redis": "^5.12.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@eslint/eslintrc": "^3.3.6",
    "eslint": "^9",
    "eslint-config-next": "^15.5.21"
  }
}
